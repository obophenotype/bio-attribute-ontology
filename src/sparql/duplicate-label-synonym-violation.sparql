PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX oboInOwl: <http://www.geneontology.org/formats/oboInOwl#>

# A label of one class is an exact synonym (of any synonym type) of a different class.
# Unlike ROBOT's duplicate_label_synonym, a class repeating its own label as a synonym is not flagged.
SELECT DISTINCT ?entity ?property ?value WHERE {
  VALUES ?property { oboInOwl:hasExactSynonym }
  ?entity rdfs:label ?value .
  ?entity2 ?property ?value .
  FILTER (?entity != ?entity2)
  FILTER (!isBlank(?entity) && !isBlank(?entity2))
  FILTER NOT EXISTS { ?entity owl:deprecated true }
  FILTER NOT EXISTS { ?entity2 owl:deprecated true }
}
