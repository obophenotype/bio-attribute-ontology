.PHONY: .FORCE

.PHONY: all
all: all_odk

.PHONY: all_odk
all_odk: odkversion config_check test custom_reports all_assets release_diff

.PHONY: odkversion
odkversion:
	@echo "INFO: ODK Makefile v1.7"
	@odk-helper info --tools

.PHONY: config_check
config_check:
	@if [ "$$(tr -d '\r' < $(ONT)-odk.yaml | sha256sum | cut -c1-64)" = "$(CONFIG_HASH)" ]; then \
	        echo "INFO: Repository is up-to-date." ; else \
	        echo "WARNING: Your ODK configuration has changed since this Makefile was generated." ; \
	        echo "         You may need to run 'sh run.sh update_repo'." ; \
	fi

.PHONY: test
test: odkversion validate_idranges dosdp_validation \
      reason_test sparql_test robot_reports \
      $(REPORTDIR)/validate_profile_owl2dl_$(ONT).owl.txt
	@echo "INFO: Finished running all tests successfully."

.PHONY: test_fast
test_fast:
	$(MAKE_FAST) test

.PHONY: reason_test
reason_test: $(EDIT_PREPROCESSED)
	$(ROBOT) reason --input $< \
	                --reasoner $(REASONER) \
	                --equivalent-classes-allowed asserted-only \
	                --exclude-tautologies structural

.PHONY: release_diff
release_diff: $(REPORTDIR)/release-diff.md

$(TMPDIR) $(REPORTDIR) $(MIRRORDIR) $(IMPORTDIR) $(COMPONENTSDIR) $(SUBSETDIR):
	mkdir -p $@


# ----------------------------------------
# Additional software tools
# ----------------------------------------

# ODK-managed ROBOT plugins
# ----------------------------------------

# Make sure ROBOT knows where to find plugins
export ROBOT_PLUGINS_DIRECTORY=$(TMPDIR)/plugins

# Override this rule in oba.Makefile to install custom plugins
.PHONY: custom_robot_plugins
custom_robot_plugins:

# Install all ROBOT plugins to the runtime plugins directory
.PHONY: all_robot_plugins
all_robot_plugins: $(foreach plugin,$(notdir $(wildcard $(ODK_RESOURCES_DIR)/robot/plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \
	           $(foreach plugin,$(notdir $(wildcard ../../plugins/*.jar)),$(ROBOT_PLUGINS_DIRECTORY)/$(plugin)) \
	           custom_robot_plugins  \

# Default rule to install plugins
$(ROBOT_PLUGINS_DIRECTORY)/%.jar:
	@mkdir -p $(ROBOT_PLUGINS_DIRECTORY)
	@if [ -f ../../plugins/$*.jar ]; then \
	        ln ../../plugins/$*.jar $@ ; \
	elif [ -f $(ODK_RESOURCES_DIR)/robot/plugins/$*.jar ]; then \
	        cp $(ODK_RESOURCES_DIR)/robot/plugins/$*.jar $@ ;  \
	fi

# Extra Python packages
# ----------------------------------------

# Install any additional Python packages listed in
# config/python-packages.txt. Any custom workflow in oba.Makefile
# requiring those packages should depend on this target to ensure the
# packages are installed.
.PHONY: install_python_dependencies
install_python_dependencies: $(wildcard config/python-packages.txt)
	@if [ -n "$<" ]; then python3 -m pip install --quiet --requirement $< ; fi


# ----------------------------------------
# Internal intermediate products
# ----------------------------------------

# The -edit file plus all components, but without any import module.
$(SRCMERGED): $(EDIT_PREPROCESSED) $(OTHER_SRC)
	$(ROBOT) remove --input $< --select imports --trim false \
	         merge $(foreach src, $(OTHER_SRC), --input $(src)) \
	         convert --format ofn --output $@

# Override this rule in oba.Makefile to perform any needed
# custom preprocessing on the -edit file.
$(EDIT_PREPROCESSED): $(SRC)
	$(ROBOT) convert --input $< --format ofn --output $@


# ----------------------------------------
# Quality control
# ----------------------------------------

# ROBOT reports
# ----------------------------------------

OBO_REPORT              = oba.owl-obo-report
REPORTS                 = $(OBO_REPORT)
REPORT_FILES            = $(foreach report, $(REPORTS), $(REPORTDIR)/$(report).tsv)
REPORT_FAIL_ON          = ERROR
REPORT_LABEL            = 
REPORT_PROFILE_OPTS     = --profile profile.txt

.PHONY: robot_reports
robot_reports: $(REPORT_FILES)

.PHONY: all_reports
all_reports: custom_reports robot_reports

$(REPORTDIR)/%-obo-report.tsv: % | $(REPORTDIR)
	$(ROBOT) report --input $< $(REPORT_LABEL) $(REPORT_PROFILE_OPTS) \
	                --fail-on $(REPORT_FAIL_ON) \
	                --base-iri $(URIBASE)/OBA_ \
	                --base-iri $(URIBASE)/oba \
	                --print 5 --output $@

check_for_robot_updates:
	@odk-helper check-robot-profile

# ROBOT OWL profile check
# ----------------------------------------

# The merge step is necessary to avoid undeclared entity violations.
$(REPORTDIR)/validate_profile_owl2dl_%.txt: % | $(REPORTDIR)
	$(ROBOT) merge --input $< \
	         validate-profile --profile DL \
	                          --output $@ \
	|| { cat $@ && exit 1; }
.PRECIOUS: $(REPORTDIR)/validate_profile_owl2dl_%.txt

validate_profile_%: $(REPORTDIR)/validate_profile_owl2dl_%.txt
	@echo "INFO: $* profile validation completed."

# SPARQL-based checks and reports
# ----------------------------------------

# The SPARQL queries used by those checks live in the ../sparql directory,
# in files whose name is of the form NAME-violation.sparql. Adding the
# NAME in the list below will enable the corresponding check.

SPARQL_VALIDATION_CHECKS = equivalent-classes owldef-self-reference anatomical-entity-in-def level-in-label

sparql_test: $(SRCMERGED) | $(REPORTDIR)
ifneq ($(SPARQL_VALIDATION_CHECKS),)
	$(ROBOT) verify --input $(SRCMERGED) \
	                --queries $(foreach name, $(SPARQL_VALIDATION_CHECKS), $(SPARQLDIR)/$(name)-violation.sparql) \
	                --output-dir $(REPORTDIR)
endif

# SPARQL "exports" differ from SPARQL checks in that
# (i) the files containing the queries do not have a '-violation' suffix,
# (ii) they do not trigger an error, they merely report what they found.

SPARQL_EXPORTS = basic-report

.PHONY: custom_reports
custom_reports: $(EDIT_PREPROCESSED) | $(REPORTDIR)
ifneq ($(SPARQL_EXPORTS),)
	$(ROBOT) query --input $< --use-graphs true \
	               --queries $(foreach name, $(SPARQL_EXPORTS), $(SPARQLDIR)/$(name).sparql) \
	               --format tsv --output-dir $(REPORTDIR)
endif


