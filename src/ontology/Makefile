VERSION                   = $(TODAY)

# Commands
MAKE_FAST                 = $(MAKE) IMP=false PAT=false COMP=false MIR=false
ANNOTATE_ONTOLOGY_VERSION = annotate --version-iri $(ONTBASE)/releases/$(VERSION)/$@ \
